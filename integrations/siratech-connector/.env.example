# Copy to .env and fill in. The connector MUST run from a Saudi IP (same VPS as
# whatsapp-bridge) because his.meena-health.com is Cloudflare/geo-locked to KSA.

PORT=3005
HOST=0.0.0.0

# Shared secret Meena sends as `Authorization: Bearer <token>`.
# Generate a strong random one, e.g.  openssl rand -base64 36
CONNECTOR_TOKEN=__set_a_strong_random_token__

# Siratech HIS — real credentials go in the untracked .env, NEVER here.
HIS_BASE=https://his.meena-health.com
HIS_USER=__his_employee_code__
HIS_PASS=__his_password__
# Optional: substring of the login site to pick (lookups work regardless).
# HIS_SITE=Al Rawdah
