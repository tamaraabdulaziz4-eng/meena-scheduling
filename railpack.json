{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "python -m venv --copies /app/.venv",
        "/app/.venv/bin/python -m pip install -r requirements.txt"
      ]
    }
  },
  "deploy": {
    "startCommand": "/app/.venv/bin/python -m gunicorn server.main:app -w 2 -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:$PORT --timeout 180"
  }
}

